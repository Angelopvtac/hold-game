# Copy to .env. Compose reads these too.

# Where the server listens. 0.0.0.0 lets phones on the same wifi join.
BIND=127.0.0.1
PORT=8080

# The address printed in the join QR code. Blank = auto-detect the LAN address.
# Set it when the game sits behind a tunnel or reverse proxy, e.g. https://hold.example.com
PUBLIC_URL=

# 1 only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0

# Extra page origins allowed to open the game socket (comma-separated).
ALLOWED_ORIGINS=

# Message pack (see README: Adding messages).
HOLD_MESSAGES=data/hold-messages.json

# 1 = normal speed. 0.25 runs the whole match four times faster (handy for testing).
HOLD_SCALE=1
